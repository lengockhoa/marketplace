{
  "name": "lenk-marketplace",
  "description": "LeNK's curated collection of skills and slash commands for Claude Code — bundled as one 'unic' plugin.",
  "owner": {
    "name": "lengockhoa"
  },
  "plugins": [
    {
      "name": "unic",
      "source": "./",
      "version": "1.3.1",
      "description": "unic — LeNK's unified Claude Code plugin bundle: 9 skills (unic-vue, unic-sql, unic-api, unic-architect, unic-coder, unic-debugger, unic-orchestrator, unic-researcher, unic-security-auditor) + 5 slash commands.",
      "keywords": [
        "unic",
        "vue",
        "nuxt",
        "postgresql",
        "sql",
        "agent",
        "skill",
        "slash-command",
        "lenk",
        "marketplace"
      ],
      "homepage": "https://github.com/lengockhoa/marketplace",
      "repository": {
        "type": "git",
        "url": "https://github.com/lengockhoa/marketplace.git"
      },
      "license": "MIT",
      "components": {
        "skills": [
          {
            "name": "unic-vue",
            "path": "skills/unic-vue"
          },
          {
            "name": "unic-sql",
            "path": "skills/unic-sql"
          },
          {
            "name": "unic-api",
            "path": "skills/unic-api"
          },
          {
            "name": "unic-architect",
            "path": "skills/unic-architect"
          },
          {
            "name": "unic-coder",
            "path": "skills/unic-coder"
          },
          {
            "name": "unic-debugger",
            "path": "skills/unic-debugger"
          },
          {
            "name": "unic-orchestrator",
            "path": "skills/unic-orchestrator"
          },
          {
            "name": "unic-researcher",
            "path": "skills/unic-researcher"
          },
          {
            "name": "unic-security-auditor",
            "path": "skills/unic-security-auditor"
          }
        ],
        "commands": [
          {
            "name": "document",
            "path": "slash-commands/document.md"
          },
          {
            "name": "explain",
            "path": "slash-commands/explain.md"
          },
          {
            "name": "refactor",
            "path": "slash-commands/refactor.md"
          },
          {
            "name": "review",
            "path": "slash-commands/review.md"
          },
          {
            "name": "test",
            "path": "slash-commands/test.md"
          }
        ]
      }
    }
  ]
}
